PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# -------------------------------------------------------------
# REAL EMAIL DELIVERY CONFIGURATION
# -------------------------------------------------------------
# Option A: Resend API (Recommended - sends over HTTPS port 443)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Option B: Gmail App Password
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx

# Option C: Custom SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM="Care Connect <no-reply@careconnect.in>"
